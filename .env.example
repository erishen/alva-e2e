# alva-e2e — environment configuration template
#
# Copy this file to `.env` and adjust as needed. `.env` is git-ignored (kept
# local); this `.env.example` is committed so reviewers know what is configurable.
# `playwright.config.ts` loads `.env` automatically via `dotenv/config`.

# Target host for the published playbook. Overrides the https://alva.ai default.
BASE_URL=https://alva.ai

# Playbook path (slug) to inspect. The suite is shaped around the AMD Deep-Dive
# playbook; other playbooks are best-effort and may not satisfy every assertion.
PLAYBOOK_PATH=/u/lake/playbooks/amd-deep-dive

# Ticker used by tests/markets.spec.ts (deep-link + KPI checks).
WATCH_TICKER=AMD

# CI is auto-set by GitHub Actions — do NOT set it manually here.
# CI=true
